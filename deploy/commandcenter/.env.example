# Copy to /opt/commandcenter/.env on the server and fill in real values - never commit the real
# one (same convention as nexusone's own .env.example). Generate real secrets with:
#   openssl rand -hex 32
# hex, not base64 - POSTGRES_PASSWORD gets embedded directly in DATABASE_URL below as a literal
# URL component, and base64's +, /, = characters aren't safe there without percent-encoding.
# Hex (0-9a-f only) sidesteps that whole class of bug for every secret here, not just that one.

POSTGRES_DB=commandcenter
POSTGRES_USER=commandcenter
POSTGRES_PASSWORD=

# DATABASE_URL's host is "postgres" - the compose service name, resolved via Docker's internal
# DNS - not 127.0.0.1 and not the 5434 host-published port above (that port is for host-side
# debugging only, unreachable from inside the api container's own network namespace).
DATABASE_URL=postgres://commandcenter:REPLACE_WITH_POSTGRES_PASSWORD_ABOVE@postgres:5432/commandcenter?sslmode=disable

PORT=8443
JWT_SECRET=
ADMIN_PASSWORD=

# Only needed if Remote Assist's TURN relay is actually used from this deployment - leave blank
# to run STUN-only (same honest fallback the app already has for a missing/unreachable TURN
# server).
TURN_SECRET=
TURN_URL=
